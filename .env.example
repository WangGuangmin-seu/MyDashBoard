# Copy to .env for local runs (.env is gitignored). CI uses GitHub Actions secrets.
EIA_API_KEY=
FEISHU_WEBHOOK_URL=
FEISHU_SECRET=

# Optional: deployed dashboard URL — the daily digest card uses it for the
# "打开看板" button. Leave empty to send the digest without a button.
DASHBOARD_SITE_URL=

# Local only: this machine's network intercepts TLS with a self-signed root.
# Set to 1 to skip verification locally. Never set in CI.
DASHBOARD_INSECURE_TLS=1
